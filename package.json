{
  "name": "@trust-medical/livewire-datepicker-ui",
  "version": "0.2.0",
  "description": "A lightweight, dependency-free date / time / datetime picker built on Alpine.js for Laravel & Livewire.",
  "license": "MIT",
  "type": "module",
  "author": "Trust Medical <fukuhara@trust-medical.jp>",
  "homepage": "https://github.com/trust-medical/livewire-datepicker-ui",
  "repository": {
    "type": "git",
    "url": "https://github.com/trust-medical/livewire-datepicker-ui.git"
  },
  "sideEffects": [
    "**/*.css",
    "./resources/js/datepicker/index.ts",
    "./dist/datepicker.iife.js"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/datepicker.iife.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./css": "./dist/datepicker.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "resources/js",
    "resources/css",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "workbench:css": "tailwindcss -i workbench/resources/css/app.css -o workbench/build/app.css --minify",
    "screenshots": "playwright test --config=playwright.screenshots.config.ts --project=chromium",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"resources/**/*.{ts,css}\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"resources/**/*.{ts,css}\" \"tests/**/*.ts\""
  },
  "peerDependencies": {
    "alpinejs": "^3.13"
  },
  "peerDependenciesMeta": {
    "alpinejs": {
      "optional": false
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@playwright/test": "^1.48.0",
    "@tailwindcss/cli": "^4.0.0",
    "@types/alpinejs": "^3.13.10",
    "@types/node": "^22.7.0",
    "@vitest/coverage-v8": "^2.1.0",
    "alpinejs": "^3.14.1",
    "eslint": "^9.13.0",
    "globals": "^15.11.0",
    "happy-dom": "^15.7.4",
    "prettier": "^3.3.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0",
    "vite": "^5.4.10",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^2.1.0"
  }
}
